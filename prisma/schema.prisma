generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid()) @db.Uuid
  name         String         @db.VarChar(80)
  email        String         @unique @db.VarChar(254)
  passwordHash String         @db.VarChar(255)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime       @updatedAt @db.Timestamptz(3)
  favorites    FavoriteFilm[]
  watched      WatchedFilm[]
}

model Film {
  id        String  @id @default(uuid()) @db.Uuid
  slug      String  @unique @db.VarChar(120)
  title     String  @db.VarChar(160)
  summary   String  @db.Text
  year      Int
  director  String  @db.VarChar(120)
  mood      String  @db.VarChar(120) // ключевое настроение
  country   String  @db.VarChar(120)
  image     String  @db.VarChar(240)
  imageAlt  String  @db.VarChar(240)
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)
  rating    Decimal @default(0) @db.Decimal(3, 1) // 0.0–10.0

  genres       FilmGenre[]
  tags         FilmTag[]
  actors       FilmActor[]
  favorites    FavoriteFilm[]
  watchedFilms WatchedFilm[]

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)
}

model Genre {
  id    String      @id @default(uuid()) @db.Uuid
  slug  String      @unique @db.VarChar(60)
  name  String      @db.VarChar(80)
  films FilmGenre[]
}

model FilmGenre {
  filmId  String @db.Uuid
  genreId String @db.Uuid
  film    Film   @relation(fields: [filmId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([filmId, genreId])
  @@index([genreId])
}

model Tag {
  id    String    @id @default(uuid()) @db.Uuid
  slug  String    @unique @db.VarChar(60)
  name  String    @db.VarChar(80)
  films FilmTag[]
}

model FilmTag {
  filmId String @db.Uuid
  tagId  String @db.Uuid
  film   Film   @relation(fields: [filmId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([filmId, tagId])
  @@index([tagId])
}

model Actor {
  id    String      @id @default(uuid()) @db.Uuid
  slug  String      @unique @db.VarChar(120)
  name  String      @db.VarChar(160)
  films FilmActor[]
}

model FilmActor {
  filmId  String @db.Uuid
  actorId String @db.Uuid
  film    Film   @relation(fields: [filmId], references: [id], onDelete: Cascade)
  actor   Actor  @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@id([filmId, actorId])
  @@index([actorId])
}

model FavoriteFilm {
  userId    String   @db.Uuid
  filmId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([userId, filmId])
  @@index([filmId])
}

model WatchedFilm {
  userId    String   @db.Uuid
  filmId    String   @db.Uuid
  note      String?  @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  film Film @relation(fields: [filmId], references: [id], onDelete: Cascade)

  @@id([userId, filmId])
  @@index([filmId])
  @@index([userId])
}
